[sub_resource type="GDScript" id="GDScript_rku1e"]
script/source = "extends ProgressBar

@export var auto_start: bool = true

@export var recharge_time: float = Shared.aa_cooldown
@onready var timer = $Timer
@onready var board = Board

@export var is_game_over: bool = false

func _ready():
	min_value = 0
	max_value = 100
	value = 100
	
	timer.wait_time = 0.1
	timer.timeout.connect(_on_timer_timeout)
	
	if auto_start:
		start_recharge()

func _input(event):
	if (event is InputEventKey and event.pressed and event.keycode == KEY_P) and value == max_value:
		reset_progress()

func start_recharge():
	timer.start()

func stop_recharge():
	timer.stop()

func reset_progress():
	value = 0
	timer.stop()
	start_recharge()  # Automatically start recharging again

func _on_timer_timeout():
	if !is_game_over:
		var increment = (max_value / recharge_time) * timer.wait_time
		value += increment
		
		if value >= max_value:
			value = max_value
			timer.stop()
			fully_charged.emit()

signal fully_charged


func _on_board_game_over() -> void:
	is_game_over = true
"

